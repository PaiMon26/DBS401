@article{yang_aptrec_2026,
	title = {{APTREC}: {APT} tactic/technique recognition based on large language model},
	volume = {280},
	issn = {1389-1286},
	url = {https://www.sciencedirect.com/science/article/pii/S1389128626001581},
	doi = {https://doi.org/10.1016/j.comnet.2026.112146},
	abstract = {The rapid evolution of advanced persistent threats ({APTs}) poses a serious challenge to cybersecurity. Unlike most current studies that focus on detecting a single attack event, understanding the tactics and techniques used by attackers to implement {APT} activities within an organization, such as the {MITRE} {ATT}\&{CK} framework, is important to improve security operations. In existing {APT} tactic/technique mapping methods, rule-based approaches heavily rely on expert knowledge, resulting in coarse tactical classification granularity and strong subjectivity in rules, making it difficult to effectively identify fine-grained techniques; traditional machine learning methods, on the other hand, suffer from limited context representation capabilities, leading to low recognition rates and insufficient interpretability. In response to the above problems, we propose {APTREC}, the first attempt to leverage large language models ({LLMs}) for recognizing {APT} tactics/techniques from subgraphs. To address the data sparsity issue, {APTREC} constructs a tactic-aligned subgraph dataset that aligns with the {MITRE} {ATT}\&{CK} framework. To improve precision, {APTREC} employs a two-stage inference architecture. A technique recognition module parses attack context semantic features, while a tactic reasoning module filters the optimal tactics. Experimental results demonstrate that {APTREC} achieves a 13\% F1-score improvement and a 9\% recall rate increase in {APT} tactic recognition compared to existing representative methods, and it also offers strong explainability.},
