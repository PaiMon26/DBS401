@article{lust_survey_2026,
	title = {A survey on assessing the generalization area of neural networks: Uncertainty, out-of-distribution and adversarial samples},
	volume = {706},
	issn = {0925-2312},
	url = {https://www.sciencedirect.com/science/article/pii/S092523122602401X},
	doi = {https://doi.org/10.1016/j.neucom.2026.135003},
	abstract = {Deep Neural Networks ({DNNs}) have achieved state-of-the-art performance in numerous applications. However, determining whether a {DNN} will produce the correct output for a given input is a non-trivial problem. A {DNN} is expected to deliver the correct output if the input is within its generalization envelope. In this case, the information contained in the input sample is processed reliably by the network. Assessing at inference time whether a {DNN} is generalizing correctly is of great practical importance. Currently, approaches that try to achieve this goal are investigated rather independently across different problem setups, leading to three main fields of research: predictive uncertainty, out-of-distribution detection, and adversarial example detection. This survey connects these three fields within the broader framework of investigating the generalization performance of machine learning methods, particularly {DNNs}. We highlight the common ground, point to the most promising approaches, and provide a structured overview of methods that offer a means to establish at inference time if an input is within the generalization envelope of a {DNN}.},
	pages = {135003},
	journaltitle = {Neurocomputing},
	author = {Lust, Julia and Condurache, Alexandru P.},
	date = {2026},
	keywords = {Adversarial example detection, Deep learning, Generalization, Out-of-distribution detection, Uncertainty prediction},
}

