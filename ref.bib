@article{zhu_traceback_nodate,
	title = {{TraceBack}: Sequence-Enhanced and Causality-Driven Attack Scenario Reconstruction from Provenance Graphs},
	abstract = {In recent years, Advanced Persistent Threat ({APT}) attacks have increased significantly, causing severe damage to critical industries. Provenance graph based attack investigation helps analysts trace attack entry points and assess impact, but current methods still face challenges like dependency explosion, high false negatives, and high false positives. To address these issues, we propose an novel attack investigation system named {TRACEBACK}. We first optimize the provenance graph to reduce dependency explosion, then apply Point of Interest ({POI}) based causal analysis on the compressed graph to filter irrelevant events and entities. This approach reduces the provenance graph to be analyzed and reduces the overhead of the investigation process while maintaining low false negatives. Finally, we propose a sequence-enhanced {APT} attack investigation method that extracts semantically rich entities and events, and combines a {VAE} model for anomaly detection, effectively reducing false positives by identifying the most relevant attack events. Experimental results demonstrate that achieves excellent performance on public datasets: the generated key component graph has an average number of edges of 64, with no false negatives, and the number of false positives is reduced by 2330\% compared to the state-of-the-art ({SOTA}) method.},
	author = {{ZhuⰠ}, Tiantian and {LiⰠ}, Mingda and {WangⰠ整}, Zijun},
	langid = {english},
	file = {PDF:files/254/ZhuⰠ et al. - TraceBack Sequence-Enhanced and Causality-Driven Attack Scenario Reconstruction from Provenance Gra.pdf:application/pdf},
}

@article{zeng_auditing_2015,
	title = {Auditing overhead, auditing adaptation, and benchmark evaluation in Linux},
	volume = {8},
	rights = {http://onlinelibrary.wiley.com/{termsAndConditions}\#vor},
	issn = {1939-0114, 1939-0122},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/sec.1277},
	doi = {10.1002/sec.1277},
	abstract = {Logging is a critical component of Linux auditing. However, our experiments indicate that the logging overhead can be signiﬁcant. The paper aims to leverage the performance overhead introduced by Linux audit framework under various usage patterns. The study on the problem leads to an adaptive audit-logging mechanism. Many security incidents or other important events are often accompanied with precursory events. We identify important precursory events – the vital signs of system activity and the audit events that must be recorded. We then design an adaptive auditing mechanism that increases or reduces the type of events collected and the frequency of events collected based upon the online analysis of the vital-sign events. The adaptive auditing mechanism reduces the overall system overhead and achieves a similar level of protection on the system and network security. We further adopt {LMbench} to evaluate the performance of key operations in Linux with compliance to four security standards. Copyright © 2015 John Wiley \& Sons, Ltd.},
	pages = {3523--3534},
	number = {18},
	journaltitle = {Security and Communication Networks},
	shortjournal = {Security Comm Networks},
	author = {Zeng, Lei and Xiao, Yang and Chen, Hui},
	urldate = {2026-09-25},
